# Fit backend configuration. The app reads only the process environment (it
# does not load .env files), so copy this to .env and load it into your shell:
#   set -a; source .env; set +a; npm run dev
# Every variable is documented in docs/configuration.md.
# Placeholders only: never commit real values.

# PORT=4190
# PUBLIC_BASE_URL=http://localhost:4190

# Taico (federated auth). TAICO_ISSUER is required in production.
# TAICO_ISSUER=https://taico.app
# TAICO_AUTHORIZATION_SERVERS=https://taico.app/mcp/fit/0.0.0

# Database: unset = embedded PGlite in apps/backend/.data/pglite (development only)
# DATABASE_URL=postgresql://fit:fit@localhost:5432/fit

# 32 random bytes, base64 (openssl rand -base64 32). Required in production.
# TOKEN_ENCRYPTION_KEY=

# Strava (https://www.strava.com/settings/api)
# STRAVA_CLIENT_ID=
# STRAVA_CLIENT_SECRET=
# STRAVA_WEBHOOK_SECRET=            # openssl rand -hex 24
# STRAVA_WEBHOOK_SUBSCRIPTION_ID=   # returned when the push subscription is created

# Garmin Connect Developer Program (approval required, see docs/providers/garmin.md)
# GARMIN_CLIENT_ID=
# GARMIN_CLIENT_SECRET=
# GARMIN_WEBHOOK_SECRET=            # openssl rand -hex 24
